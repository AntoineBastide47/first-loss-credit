{
  "_comment": "Reference only. Run `node hook/setup.mjs --register grok` to write this with absolute paths into the project's .grok/hooks/xrpl-devex.json. Grok uses a single command string (not command+args). Trust the project with /hooks-trust before hooks run.",
  "hooks": {
    "SessionStart": [{ "matcher": "", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event SessionStart", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event UserPromptSubmit", "timeout": 10 }] }],
    "PostToolUse": [
      { "matcher": "Bash|Write|Edit|Read|WebFetch|WebSearch|run_terminal_command|write|search_replace|read_file|web_search|web_fetch|open_page", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event PostToolUse", "timeout": 10 }] },
      { "matcher": "Bash|run_terminal_command", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event PostToolUse --package-install", "timeout": 10 }] }
    ],
    "PostToolUseFailure": [{ "matcher": "Bash|run_terminal_command|Write|Edit|write|search_replace", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event PostToolUseFailure", "timeout": 10 }] }],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event Stop", "timeout": 20 },
          { "type": "command", "command": "node \"${REPO}/hook/stop-hook.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "PreCompact": [{ "matcher": "", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event PreCompact", "timeout": 10 }] }],
    "SessionEnd": [{ "matcher": "", "hooks": [{ "type": "command", "command": "node \"${REPO}/hook/capture.mjs\" --event SessionEnd", "timeout": 10 }] }]
  }
}
